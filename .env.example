# Defaults for this service, and the only place a provider host is written
# down. Copy to .env to override locally:  cp .env.example .env
#
# Precedence: environment  >  .env  >  this file. So
# `FX_UPSTREAM_BASE=http://localhost:9999 ./run.sh` always wins.

FX_UPSTREAM_BASE=https://api.frankfurter.dev

PORT=8080
